# FPA Dashboard — static hosting on cPanel (financial-performance.tapworkspace.com)
# Mirrors the anti-crawl / no-cache headers the old Heroku server.js used to send.

DirectoryIndex index.html

<IfModule mod_headers.c>
  Header set X-Robots-Tag        "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options     "DENY"
  Header set Referrer-Policy     "no-referrer"
  Header set Cache-Control       "no-store, no-cache, must-revalidate, private"
  Header set Pragma              "no-cache"
</IfModule>

# Always serve fresh HTML (the dashboard is replaced on every data update)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
